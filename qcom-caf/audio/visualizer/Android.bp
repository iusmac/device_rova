cc_library_shared {
    name: "libqcomvisualizer",
    relative_install_path: "soundfx",
    vendor: true,

    srcs: [
        "offload_visualizer.c"
    ],

    cflags: [
        "-fvisibility=hidden",
        "-Wall",
        "-Werror",
        "-Wno-gnu-designator",
        "-Wno-shorten-64-to-32",
        "-Wno-sign-compare",
        "-Wno-tautological-compare",
        "-Wno-typedef-redefinition",
        "-Wno-unused-function",
        "-Wno-unused-label",
        "-Wno-unused-local-typedef",
        "-Wno-unused-parameter",
        "-Wno-unused-value",
        "-Wno-unused-variable",
    ],

    include_dirs: [
        "external/tinyalsa/include",
        "system/media/audio_effects/include",
    ],

    header_libs: [
        "libsystem_headers",
        "libhardware_headers",
    ],

    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
        "libtinyalsa",
    ],

    sanitize: {
        integer_overflow: true,
    },
}
