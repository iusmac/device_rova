

cc_library_shared {
    name: "libmmcamera_interface",
    compile_multilib: "32",
    cflags: [
        "-DDAEMON_PRESENT",
        "-DSYSTEM_HEADER_PREFIX=sys",
        "-DUSE_ION",
        "-DVENUS_PRESENT",
        "-D_ANDROID_",
        "-DQCAMERA_REDEFINE_LOG",
        "-DCAMERA_ION_HEAP_ID=ION_IOMMU_HEAP_ID",
        "-Wall",
        "-Wextra",
        "-Wno-error",
        "-Wno-implicit-function-declaration",
    ],
    include_dirs: [
        "device/xiaomi/rova/camera/QCamera2/stack/common",
        "system/media/camera/include",
    ],
    local_include_dirs: ["inc"],
    header_libs: [
        "libhardware_headers",
        "media_plugin_headers",
        "mi8937_camera_common_headers",
        "generated_kernel_headers",
    ],

    device_specific: true,

    shared_libs: [
        "libdl",
        "libcutils",
        "liblog",
    ],
    srcs: [
        "src/mm_camera_interface.c",
        "src/mm_camera.c",
        "src/mm_camera_channel.c",
        "src/mm_camera_stream.c",
        "src/mm_camera_thread.c",
        "src/mm_camera_sock.c",
    ],
}
